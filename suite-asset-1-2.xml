<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Full Suite — Asset Parts 1-2 + Location (75 TCs)" verbose="1">

    <listeners>
        <listener class-name="com.egalvanic.qa.listeners.ConsoleProgressListener"/>
    </listeners>

    <test name="Full Asset Tests Part 1 (29 TCs)">
        <classes>
            <class name="com.egalvanic.qa.testcase.AssetPart1TestNG"/>
        </classes>
    </test>

    <test name="Full Asset Tests Part 2 (40 TCs)">
        <classes>
            <class name="com.egalvanic.qa.testcase.AssetPart2TestNG"/>
        </classes>
    </test>

    <test name="Asset — Select or Create Location (Building/Floor/Room cascade) (6 TCs)">
        <classes>
            <class name="com.egalvanic.qa.testcase.AssetLocationTestNG"/>
            <!-- Guards eg-pz-frontend PR #1127: the "Let's get your assets in" invite must
                 be held while an Upload Anything job runs, and must FAIL OPEN when the
                 active-job lookup breaks. Uses fault injection; asserts a positive control
                 first so a page that never shows the invite cannot pass vacuously. -->
            <class name="com.egalvanic.qa.testcase.UploadInviteGatingTestNG"/>
        </classes>
    </test>

</suite>
