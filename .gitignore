# Maven build output
target/

# Test output & screenshots
test-output/
# ...EXCEPT the bug-detection report — published to a stable raw GitHub URL
# so claude.ai Routine Runs can fetch it directly. Auto-refreshed by CI.
!test-output/
test-output/screenshots/
test-output/visual-baselines/
test-output/visual-diffs/
test-output/healed-locators.json
test-output/*.png
test-output/*.html
test-output/*.txt
# Allow only the JSON the routine reads:
!test-output/bug-detection-report.json

# Extent reports (generated per run)
reports/

# IDE files
.classpath
.project
.settings/
*.iml
.idea/

# Playwright MCP cache (local debugging artifacts)
.playwright-mcp/
playwright-*.png

# OS files
.DS_Store
Thumbs.db

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.zip

# Developer product code — READ-ONLY reference clone (Egalvanic/eg-pz-frontend).
# Lets us browse the frontend source for writing locators. NEVER committed to
# this repo, NEVER pushed to the developer repo. Update with: git -C eg-pz-frontend-reference pull
eg-pz-frontend-reference/

# Non-functional scan outputs (regenerated per run)
security/zap-report.*
perf/k6-summary.json

# Scratch/extracted data for the hidden SLD module (large binaries; not repo content)
docs/sld-intelligence/

# eGalvanic api-contract-review — dev token config (never commit)
.api-contract.env

# Sentry auth token for the 502-correlation test — LOCAL ONLY, never commit
.sentry-auth-token

# Generated Jira-paste bundles (self-contained HTML with base64 images)
docs/jira-export/
docs/qa-review-board.html
docs/report-artifacts/

# Large QA reference videos — keep local, never push (GitHub 100MB hard limit)
testcase/service_workorder_video/
testcase/IR_video/
*.mp4

# derived web-sized copies of evidence screenshots (inlined into the artifact)
docs/bug-evidence/*/web/

# Unfixed security findings: Jira only, never in this public repo (13 Nov 2026, ZP-5284)
docs/bug-evidence/2026-11-13-rfq/_bugs/upload-anything-job-read-scope/
